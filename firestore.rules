rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'ubedmo650@gmail.com' ||
        request.auth.token.email == 'ubada900593@gmail.com' ||
        request.auth.token.email == 'mohdubaid.ik@gmail.com'
      );
    }

    function isAdmin() {
      return isSuperAdminEmail() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users Collection (Hybrid Login: Google + Free Fire UID + Password)
    match /users/{userId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Tournaments Collection
    match /tournaments/{tournamentId} {
      allow get, list: if true;
      allow create, delete: if isAdmin();
      allow update: if true;

      match /registrations/{registrationId} {
        allow get, list: if true;
        allow create, update: if true;
        allow delete: if isAdmin();
      }
    }

    // Matches Collection
    match /matches/{matchId} {
      allow get, list: if true;
      allow create, delete: if isAdmin();
      allow update: if true;
    }

    // Deposit Requests
    match /depositRequests/{depositId} {
      allow get, list, create: if true;
      allow update, delete: if isAdmin();
    }

    // Withdrawal Requests
    match /withdrawalRequests/{withdrawalId} {
      allow get, list, create: if true;
      allow update, delete: if isAdmin();
    }

    // Global Admin Settings
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Admin Whitelist
    match /admins/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
