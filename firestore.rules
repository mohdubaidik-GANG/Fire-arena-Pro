rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'ubedmo650@gmail.com' ||
        request.auth.token.email == 'ubada900593@gmail.com' ||
        request.auth.token.email == 'mohdubaid.ik@gmail.com'
      );
    }

    function isAdmin() {
      return isSuperAdminEmail() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users Collection (Hybrid Login: Google + Free Fire UID + Password)
    match /users/{userId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow get, list: if true;
        allow create, update, delete: if true;
      }

      match /transactions/{transactionId} {
        allow get, list: if true;
        allow create, update: if true;
        allow delete: if isAdmin();
      }
    }

    // Broadcast Notifications (Global announcements & alerts)
    match /broadcast_notifications/{notificationId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Root Notifications Collection (Room ID & Password, match updates, global broadcasts)
    match /notifications/{notifId} {
      allow get, list: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Tournaments Collection (Admin can create; allow write, delete if request.auth != null)
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write, delete: if request.auth != null;

      match /registrations/{registrationId} {
        allow read, write, delete: if true;
      }
    }

    // Matches Collection (Direct deletion allowed for authenticated users)
    match /matches/{matchId} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }

    // Deposit Orders Collection (Direct UPI Orders)
    match /deposit_orders/{orderId} {
      allow get, list, create, update: if true;
      allow delete: if isAdmin();
    }

    // Transactions Collection (Direct Ledger & Passbook)
    match /transactions/{transactionId} {
      allow get, list, create, update: if true;
      allow delete: if isAdmin();
    }

    // Match Result Proofs (Screenshot proof submitted by players)
    match /matchProofs/{proofId} {
      allow get, list, create: if true;
      allow update, delete: if isAdmin();
    }

    // Deposit Requests
    match /depositRequests/{depositId} {
      allow get, list, create: if true;
      allow update, delete: if isAdmin();
    }

    // Wallet History (UPI & Payout records)
    match /walletHistory/{historyId} {
      allow get, list, create: if true;
      allow update, delete: if isAdmin();
    }

    // Withdrawal Requests
    match /withdrawalRequests/{withdrawalId} {
      allow get, list, create: if true;
      allow update, delete: if isAdmin();
    }

    // Global Admin Settings
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Admin Whitelist
    match /admins/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
